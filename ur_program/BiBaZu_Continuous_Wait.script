def BiBaZu_Continuous_Wait():
  local command = read_input_integer_register(43)
  while command == last_command:
    sync()
    command = read_input_integer_register(43)
  end

  local requested_angle = read_input_integer_register(42)
  local valid = requested_angle >= 155 and requested_angle <= 210

  if valid:
    global angle = requested_angle
    global active_command = command
    global command_valid = True
    write_output_integer_register(43, 2)
  else:
    global angle = 0
    global command_valid = False
    global last_command = command
    write_output_integer_register(43, -1)
    write_output_integer_register(42, command)
  end
end

BiBaZu_Continuous_Wait()
